FROM rust:1.88.0-slim-bookworm@sha256:38bc5a86d998772d4aec2348656ed21438d20fcdce2795b56ca434cf21430d89

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
        git \
        python3 \
    && git --version \
    && python3 --version \
    && rm -rf /var/lib/apt/lists/*

COPY --chmod=0555 pie-adapter-cc /usr/local/bin/stwo-pie-adapter-cc
RUN /usr/local/bin/stwo-pie-adapter-cc \
        -x c -shared /dev/null -o /tmp/stwo-pie-adapter-linker-probe.so \
    && rm /tmp/stwo-pie-adapter-linker-probe.so
