#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 ]]; then
  echo "usage: $0 witness_pedersen_builtin tiny sm_86" >&2
  exit 2
fi

slab="$1"
case_class="$2"
arch="$3"
if [[ "$slab" != "witness_pedersen_builtin" || "$case_class" != "tiny" ]]; then
  echo "stage-0 sanitizers currently support only: witness_pedersen_builtin tiny" >&2
  exit 2
fi
if [[ ! "$arch" =~ ^sm_([0-9][0-9][0-9]?)$ ]]; then
  echo "architecture must look like sm_86, sm_90, or sm_100" >&2
  exit 2
fi
sm="${BASH_REMATCH[1]}"

command -v compute-sanitizer >/dev/null || {
  echo "compute-sanitizer is required" >&2
  exit 1
}

lab_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
repo_root="$(cd "$lab_root/.." && pwd)"
pod_id="${RUNPOD_POD_ID:-}"
local_root="${GPU_LAB_LOCAL_ROOT:-}"
if [[ -z "$pod_id" ]]; then
  local_root=""
elif [[ -z "$local_root" && -f /tmp/stwo-gpu-lab/ACTIVE_ROOT ]]; then
  IFS= read -r local_root < /tmp/stwo-gpu-lab/ACTIVE_ROOT
fi
if [[ -n "$pod_id" && -z "$local_root" ]]; then
  echo "RUNPOD pod requires the labctl-declared GPU_LAB_LOCAL_ROOT" >&2
  exit 1
fi
if [[ -n "$local_root" ]]; then
  build_root="${GPU_LAB_BUILD_ROOT:-$local_root/build/gpu-lab-sm$sm}"
else
  build_root="${GPU_LAB_BUILD_ROOT:-$repo_root/build/gpu-lab-sm$sm}"
fi
run_dir="$build_root/runs/witness_pedersen_builtin-tiny"
harness="$build_root/stwo-gpu-lab"
staging="$run_dir/staging.json"
oracle_index="$lab_root/cases/tiny/witness_pedersen_builtin.oracle-index.json"
module_index="$build_root/modules/witness_pedersen_builtin.sm$sm.module.json"
execution="$run_dir/execution.json"
replay="$run_dir/fixture.replay"
plan="$run_dir/execution.plan"

python3 "$lab_root/tools/stage-run" verify --record "$staging" >/dev/null
fixture="$(python3 - "$staging" <<'PY'
import json, pathlib, sys
record = json.loads(pathlib.Path(sys.argv[1]).read_text())
print(next(item["destination_path"] for item in record["entries"] if item["role"] == "fixture"))
PY
)"

for artifact in "$harness" "$fixture" "$oracle_index" "$module_index" "$execution" "$replay" "$plan" "$staging"; do
  [[ -e "$artifact" ]] || {
    echo "missing prepared artifact: $artifact; run tools/quick-loop first" >&2
    exit 1
  }
done

read -r plan_sha manifest_sha <<<"$(python3 - "$plan" "$execution" <<'PY'
import hashlib
import pathlib
import sys

for raw in sys.argv[1:]:
    print(hashlib.sha256(pathlib.Path(raw).read_bytes()).hexdigest(), end=" ")
PY
)"

common=(
  --plan "$plan"
  --plan-sha256 "$plan_sha"
  --replay "$replay"
  --manifest "$execution"
  --manifest-sha256 "$manifest_sha"
  --device "${GPU_LAB_DEVICE:-0}"
  --mode correctness
)

mkdir -p "$run_dir/sanitizers"
for tool in memcheck racecheck initcheck synccheck; do
  result="$run_dir/sanitizers/$tool.result.json"
  log="$run_dir/sanitizers/$tool.log"
  compute-sanitizer --tool "$tool" --error-exitcode 86 \
    "$harness" "${common[@]}" --result "$result" 2>&1 | tee "$log"
  python3 "$lab_root/tools/lab.py" validate-result \
    --result "$result" --fixture "$fixture" --module-index "$module_index" \
    --oracle-index "$oracle_index" \
    --execution "$execution" --replay "$replay" --plan "$plan" \
    --harness "$harness" --mode correctness
done

python3 - "$run_dir/sanitizers" <<'PY'
import hashlib
import json
import os
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
tools = {}
for name in ("memcheck", "racecheck", "initcheck", "synccheck"):
    result = root / f"{name}.result.json"
    log = root / f"{name}.log"
    tools[name] = {
        "log_sha256": hashlib.sha256(log.read_bytes()).hexdigest(),
        "result_sha256": hashlib.sha256(result.read_bytes()).hexdigest(),
    }
record = {
    "schema_version": "stwo.gpu-lab.sanitizer-summary.v1",
    "passed": True,
    "tools": tools,
}
payload = (json.dumps(record, indent=2, sort_keys=True) + "\n").encode()
destination = root / "summary.json"
temporary = root / f"summary.json.{os.getpid()}.tmp"
temporary.write_bytes(payload)
os.replace(temporary, destination)
print(json.dumps(record, sort_keys=True))
PY
