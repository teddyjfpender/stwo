#!/usr/bin/env python3
"""Fail closed when a GPU-lab feedback record exceeds its declared budget."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

from gpu_lab.common import load_json
from gpu_lab.loop import SLO_BUDGETS, check_loop_slo


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("record", type=Path)
    parser.add_argument("kind", choices=tuple(SLO_BUDGETS))
    args = parser.parse_args()
    check_loop_slo(load_json(args.record), args.kind)
    print(f"gpu-lab {args.kind} feedback SLO: PASS")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError) as error:
        print(f"check-loop-slo: {error}", file=sys.stderr)
        raise SystemExit(1) from None
