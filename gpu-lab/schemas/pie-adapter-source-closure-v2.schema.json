{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stwo.dev/gpu-lab/pie-adapter-source-closure-v2.schema.json",
  "title": "Stwo GPU lab PIE adapter live source closure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_closure", "source_closure_sha256"],
  "properties": {
    "schema_version": {"const": "stwo.gpu-lab.pie-adapter-source-closure.v2"},
    "source_closure_sha256": {"$ref": "#/$defs/sha256"},
    "source_closure": {
      "type": "object", "additionalProperties": false,
      "required": [
        "evidence_status", "writer_precondition", "attestation_scope",
        "production_admissible", "correctness_admissible",
        "performance_admissible", "inventory_sha256", "repository_commits", "sources"
      ],
      "properties": {
        "evidence_status": {"const": "live-explicit-inventory-identity-only-v2"},
        "writer_precondition": {"const": "caller-guaranteed-no-concurrent-source-or-output-writers-v1"},
        "attestation_scope": {"const": "point-in-time-live-identity-observations-v1"},
        "production_admissible": {"const": false},
        "correctness_admissible": {"const": false},
        "performance_admissible": {"const": false},
        "inventory_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of canonical JSON for the authenticated inventory value; the CLI separately pins exact inventory file bytes."
        },
        "repository_commits": {
          "type": "object", "additionalProperties": false,
          "required": ["stwo", "stwo-cairo"],
          "properties": {"stwo": {"$ref": "#/$defs/commit"}, "stwo-cairo": {"$ref": "#/$defs/commit"}}
        },
        "sources": {
          "type": "array", "minItems": 2, "maxItems": 1024, "uniqueItems": true,
          "items": {"$ref": "#/$defs/source_identity"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])"},
    "relative_path": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^(?![\\s\\S]*[^ -~])(?!/)(?!.*//)(?!.*\\\\)(?!\\.\\.?(?:/|$))(?!.*(?:/\\.\\.?)(?:/|$))(?!.*\/$)[ -~]+$"
    },
    "source_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "path", "byte_length", "sha256"],
      "properties": {
        "repository": {"enum": ["stwo", "stwo-cairo"]},
        "path": {"$ref": "#/$defs/relative_path"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
