{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stwo.dev/gpu-lab/semantic-fixture-v1.schema.json",
  "title": "Stwo GPU lab semantic fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "fixture_class",
    "proof_identity",
    "semantic_identity",
    "full_proof_semantic_hash",
    "boundary",
    "oracle",
    "semantic_payload"
  ],
  "properties": {
    "schema_version": {"const": "stwo.gpu-lab.semantic-fixture.v1"},
    "fixture_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
    "fixture_class": {"const": "tiny"},
    "proof_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "full_proof"],
      "properties": {
        "kind": {"const": "synthetic_kernel_slice"},
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
        "full_proof": {"const": false}
      }
    },
    "semantic_identity": {"$ref": "#/$defs/semantic_identity"},
    "full_proof_semantic_hash": {"type": "null"},
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "entry", "exit"],
      "properties": {
        "operation": {"const": "cairo.witness.pedersen_builtin"},
        "entry": {"const": "cairo.witness.pedersen_builtin.logical-inputs"},
        "exit": {"const": "cairo.witness.pedersen_builtin.base-trace-and-facts"}
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version",
        "candidate_independent",
        "provenance",
        "reference_closure_sha256",
        "reference_sources"
      ],
      "properties": {
        "implementation": {"const": "gpu-lab/tools/lab.py:pedersen_oracle"},
        "version": {"const": "candidate-free-scalar-v2"},
        "candidate_independent": {"const": true},
        "provenance": {"const": "reviewed candidate-free PedersenBuiltin slab descriptor"},
        "reference_closure_sha256": {"$ref": "#/$defs/sha256"},
        "reference_sources": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "path", "sha256"],
            "properties": {
              "role": {"enum": ["semantic_descriptor", "golden_evaluator", "golden_support"]},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "semantic_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "row_count", "inputs", "tables", "expected"],
      "properties": {
        "field": {"const": "M31"},
        "row_count": {"const": 32},
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["segment_start", "enabler", "iota"],
          "properties": {
            "segment_start": {"$ref": "#/$defs/nonempty_m31_words"},
            "enabler": {"$ref": "#/$defs/nonempty_ones"},
            "iota": {"$ref": "#/$defs/nonempty_m31_words"}
          }
        },
        "tables": {
          "type": "object",
          "additionalProperties": false,
          "required": ["address_to_id"],
          "properties": {
            "address_to_id": {"$ref": "#/$defs/nonempty_m31_words"}
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["output_columns", "lookup_words", "sub_words"],
          "properties": {
            "output_columns": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"$ref": "#/$defs/nonempty_m31_words"}
            },
            "lookup_words": {
              "type": "array",
              "minItems": 14,
              "maxItems": 14,
              "items": {"$ref": "#/$defs/nonempty_m31_words"}
            },
            "sub_words": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {"$ref": "#/$defs/nonempty_m31_words"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema", "scope", "sha256"],
      "properties": {
        "kind": {"const": "kernel_slice"},
        "schema": {"const": "stwo.gpu-lab.slab-semantics.v1"},
        "scope": {"const": "cairo.witness.pedersen_builtin.base-trace-and-facts"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "m31_word": {"type": "integer", "minimum": 0, "maximum": 2147483646},
    "nonempty_m31_words": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/m31_word"}
    },
    "nonempty_ones": {
      "type": "array",
      "minItems": 1,
      "items": {"const": 1}
    }
  }
}
