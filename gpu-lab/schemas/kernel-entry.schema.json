{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stwo.dev/gpu-lab/kernel-entry-v1.schema.json",
  "title": "Stwo GPU lab driver-visible kernel entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantic_operation",
    "source",
    "cache_key",
    "semantic_ir_hash",
    "symbol",
    "abi_version",
    "arguments",
    "launch",
    "module_globals",
    "effects"
  ],
  "properties": {
    "schema_version": {"const": "stwo.gpu-lab.kernel-entry.v1"},
    "semantic_operation": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
    "source": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]+\\.cu$"},
    "cache_key": {"$ref": "#/$defs/u64hex"},
    "semantic_ir_hash": {"$ref": "#/$defs/u64hex"},
    "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "abi_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
    "arguments": {"$ref": "#/$defs/arguments"},
    "launch": {"$ref": "#/$defs/launch"},
    "module_globals": {
      "type": "array",
      "items": {"$ref": "#/$defs/module_global"}
    },
    "effects": {"$ref": "#/$defs/effects"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "u64hex": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "positive_extent": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {
          "type": "string",
          "pattern": "^(?:row_count|[1-9][0-9]*\\*row_count|table_strides\\[0\\])$"
        }
      ]
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "index",
        "access",
        "parameter_offset_bytes",
        "size_bytes",
        "alignment_bytes",
        "address_space",
        "pointer_depth",
        "element_type",
        "logical_extent"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "kind": {"enum": ["device_pointer_table", "device_pointer", "u32"]},
        "index": {"type": "integer", "minimum": 0},
        "access": {"enum": ["read", "write", "read_write", "unused", "value"]},
        "parameter_offset_bytes": {"type": "integer", "minimum": 0},
        "size_bytes": {"enum": [4, 8]},
        "alignment_bytes": {"enum": [4, 8]},
        "address_space": {"enum": ["device_global", "value"]},
        "pointer_depth": {"type": "integer", "minimum": 0, "maximum": 2},
        "element_type": {"const": "u32"},
        "logical_extent": {"$ref": "#/$defs/positive_extent"},
        "count": {"type": "integer", "minimum": 1},
        "words": {"type": "integer", "minimum": 1},
        "words_per_row": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "device_pointer_table"}}},
          "then": {
            "required": ["count"],
            "properties": {
              "size_bytes": {"const": 8},
              "alignment_bytes": {"const": 8},
              "address_space": {"const": "device_global"},
              "pointer_depth": {"const": 2}
            },
            "not": {"anyOf": [{"required": ["words"]}, {"required": ["words_per_row"]}]}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "device_pointer"}}},
          "then": {
            "oneOf": [{"required": ["words"]}, {"required": ["words_per_row"]}],
            "properties": {
              "size_bytes": {"const": 8},
              "alignment_bytes": {"const": 8},
              "address_space": {"const": "device_global"},
              "pointer_depth": {"const": 1}
            },
            "not": {"required": ["count"]}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "u32"}}},
          "then": {
            "properties": {
              "access": {"const": "value"},
              "size_bytes": {"const": 4},
              "alignment_bytes": {"const": 4},
              "address_space": {"const": "value"},
              "pointer_depth": {"const": 0},
              "logical_extent": {"const": 1}
            },
            "not": {
              "anyOf": [
                {"required": ["count"]},
                {"required": ["words"]},
                {"required": ["words_per_row"]}
              ]
            }
          }
        }
      ]
    },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/argument"}
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grid_x",
        "grid_y",
        "grid_z",
        "block",
        "dynamic_shared_bytes",
        "cooperative",
        "graph_capture",
        "graph_parameter_policy",
        "parameter_buffer_size_bytes",
        "launch_bounds",
        "required_function_attributes",
        "supported_shape"
      ],
      "properties": {
        "grid_x": {"const": "ceil_div(row_count,256)"},
        "grid_y": {"const": 1},
        "grid_z": {"const": 1},
        "block": {
          "type": "array",
          "prefixItems": [{"const": 256}, {"const": 1}, {"const": 1}],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "dynamic_shared_bytes": {"const": 0},
        "cooperative": {"const": false},
        "graph_capture": {"const": true},
        "graph_parameter_policy": {"const": "row_count_change_requires_recapture"},
        "parameter_buffer_size_bytes": {"const": 60},
        "launch_bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_threads_per_block", "min_blocks_per_sm"],
          "properties": {
            "max_threads_per_block": {"const": 256},
            "min_blocks_per_sm": {"type": "null"}
          }
        },
        "required_function_attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_dynamic_shared_bytes", "preferred_shared_memory_carveout"],
          "properties": {
            "max_dynamic_shared_bytes": {"const": 0},
            "preferred_shared_memory_carveout": {"type": "null"}
          }
        },
        "supported_shape": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "row_count_min",
            "row_count_max",
            "input_columns",
            "output_columns",
            "table_pointer_slots"
          ],
          "properties": {
            "field": {"const": "M31"},
            "row_count_min": {"const": 1},
            "row_count_max": {"const": 4294967040},
            "input_columns": {"const": 3},
            "output_columns": {"const": 3},
            "table_pointer_slots": {"const": 37}
          }
        }
      }
    },
    "module_global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "size_bytes",
        "alignment_bytes",
        "mutability",
        "content_sha256",
        "initialization"
      ],
      "properties": {
        "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "alignment_bytes": {"type": "integer", "minimum": 1},
        "mutability": {"enum": ["immutable", "per_execution"]},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "initialization": {"enum": ["literal_h2d", "value_id_relocation"]}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argument",
        "region",
        "access",
        "slots",
        "offset_elements",
        "length_elements",
        "element_size_bytes"
      ],
      "properties": {
        "argument": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "region": {"enum": ["argument_value", "pointer_table", "pointee", "direct"]},
        "access": {"enum": ["read", "write", "reset"]},
        "slots": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "offset_elements": {"type": "integer", "minimum": 0},
        "length_elements": {"$ref": "#/$defs/positive_extent"},
        "element_size_bytes": {"enum": [4, 8]}
      }
    },
    "alias_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "second", "justification"],
      "properties": {
        "first": {"type": "string", "minLength": 1},
        "second": {"type": "string", "minLength": 1},
        "justification": {"type": "string", "minLength": 1}
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reads",
        "writes",
        "aliases_allowed",
        "alias_pairs",
        "reset_before_replay",
        "ranges",
        "reset_ranges"
      ],
      "properties": {
        "reads": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "writes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "aliases_allowed": {"type": "boolean"},
        "alias_pairs": {
          "type": "array",
          "items": {"$ref": "#/$defs/alias_pair"}
        },
        "reset_before_replay": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/range"},
              {"properties": {"access": {"enum": ["read", "write"]}}}
            ]
          }
        },
        "reset_ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/range"},
              {"properties": {"access": {"const": "reset"}}}
            ]
          }
        }
      }
    }
  }
}
