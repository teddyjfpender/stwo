{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stwo.dev/gpu-lab/build-recipe-v2.schema.json",
  "title": "Stwo GPU lab immutable CUDA build recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha256",
    "transitive_headers",
    "abi_sha256",
    "cache_key",
    "semantic_ir_hash",
    "exported_symbols",
    "generator_sources",
    "build_tool_sha256",
    "nvcc_path",
    "nvcc_version",
    "host_compiler_path",
    "host_compiler_version",
    "ptxas_path",
    "ptxas_version",
    "cuobjdump_path",
    "cuobjdump_version",
    "environment",
    "driver_compatibility_policy",
    "source_staging",
    "target_sm",
    "normalized_command"
  ],
  "properties": {
    "schema_version": {"const": "stwo.gpu-lab.build-recipe.v2"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "transitive_headers": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_identity"}
    },
    "abi_sha256": {"$ref": "#/$defs/sha256"},
    "cache_key": {"$ref": "#/$defs/u64hex"},
    "semantic_ir_hash": {"$ref": "#/$defs/u64hex"},
    "exported_symbols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
    },
    "generator_sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_identity"}
    },
    "build_tool_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "Hash of the canonical path/content-hash list for the complete Python lab-tool source closure."
    },
    "nvcc_path": {"$ref": "#/$defs/absolute_path"},
    "nvcc_version": {"type": "string", "minLength": 1},
    "host_compiler_path": {"$ref": "#/$defs/absolute_path"},
    "host_compiler_version": {"type": "string", "minLength": 1},
    "ptxas_path": {"$ref": "#/$defs/absolute_path"},
    "ptxas_version": {"type": "string", "minLength": 1},
    "cuobjdump_path": {"$ref": "#/$defs/absolute_path"},
    "cuobjdump_version": {"type": "string", "minLength": 1},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["NVCC_PREPEND_FLAGS", "NVCC_APPEND_FLAGS"],
      "properties": {
        "NVCC_PREPEND_FLAGS": {"const": ""},
        "NVCC_APPEND_FLAGS": {"const": ""}
      }
    },
    "driver_compatibility_policy": {"type": "string", "minLength": 1},
    "source_staging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "root", "directory", "source_name", "mtime_ns"],
      "properties": {
        "policy": {"const": "private-content-addressed-canonical-path-v1"},
        "root": {"const": "/tmp/stwo-gpu-lab-aot-v1"},
        "directory": {"$ref": "#/$defs/sha256"},
        "source_name": {"const": "source.cu"},
        "mtime_ns": {"const": 0}
      }
    },
    "target_sm": {"type": "integer", "minimum": 50, "maximum": 999},
    "normalized_command": {
      "type": "array",
      "prefixItems": [
        {"const": "nvcc"},
        {"const": "-cubin"},
        {"const": "-O3"},
        {"const": "--std=c++17"},
        {"const": "--expt-relaxed-constexpr"},
        {"const": "-lineinfo"},
        {"type": "string", "pattern": "^-arch=sm_[0-9]{2,3}$"},
        {"const": "-ccbin"},
        {"$ref": "#/$defs/absolute_path"},
        {"const": "source.cu"},
        {"const": "-o"},
        {"const": "<output>"}
      ],
      "items": false,
      "minItems": 12,
      "maxItems": 12
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "u64hex": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "absolute_path": {"type": "string", "pattern": "^/.+"},
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "sha256"],
      "properties": {
        "repository": {"enum": ["stwo", "stwo-cairo"]},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
