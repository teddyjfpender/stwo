{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stwo.dev/gpu-lab/semantic-fixture-index-v2.schema.json",
  "title": "Stwo GPU lab streamed semantic fixture index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "fixture_id", "fixture_class", "proof_identity",
    "semantic_identity", "full_proof_semantic_hash", "boundary", "oracle",
    "production_crosscheck", "exporter_executable_sha256", "semantic_payload"
  ],
  "properties": {
    "schema_version": {"const": "stwo.gpu-lab.semantic-fixture-index.v2"},
    "fixture_id": {"type": "string", "pattern": "^(representative|stress|unseen-same-class)\\.witness_pedersen_builtin\\.prover-input-[0-9a-f]{64}\\.v1$"},
    "fixture_class": {"enum": ["representative", "stress", "unseen-same-class"]},
    "proof_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "full_proof", "source_prover_input_sha256", "source_prover_input_bytes"],
      "properties": {
        "kind": {"const": "real_prover_input_kernel_slice"},
        "id": {"type": "string", "minLength": 1},
        "full_proof": {"const": false},
        "source_prover_input_sha256": {"$ref": "#/$defs/sha256"},
        "source_prover_input_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456}
      }
    },
    "semantic_identity": {"$ref": "#/$defs/semantic_identity"},
    "full_proof_semantic_hash": {"type": "null"},
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "entry", "exit"],
      "properties": {
        "operation": {"const": "cairo.witness.pedersen_builtin"},
        "entry": {"const": "cairo.witness.pedersen_builtin.logical-inputs"},
        "exit": {"const": "cairo.witness.pedersen_builtin.base-trace-and-facts"}
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "candidate_independent", "provenance", "reference_closure_sha256", "reference_sources"],
      "properties": {
        "implementation": {"const": "stwo-cairo/gpu_benchmarks/lab/fixture-export"},
        "version": {"const": "independent-scalar-plus-production-simd-v3"},
        "candidate_independent": {"const": true},
        "provenance": {"const": "candidate-free scalar golden cross-checked against production PedersenBuiltin SIMD bytes"},
        "reference_closure_sha256": {"$ref": "#/$defs/sha256"},
        "reference_sources": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "path", "sha256"],
            "properties": {
              "role": {"enum": ["semantic_descriptor", "golden_evaluator", "golden_support"]},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "production_crosscheck": {"$ref": "#/$defs/source_closure"},
    "exporter_executable_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "row_count", "address_to_id", "input_chunks", "expected_chunks"],
      "properties": {
        "field": {"const": "M31"},
        "row_count": {"type": "integer", "minimum": 16, "maximum": 1048576},
        "address_to_id": {"$ref": "#/$defs/table"},
        "input_chunks": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/chunk3"}
        },
        "expected_chunks": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/chunk23"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema", "scope", "sha256"],
      "properties": {
        "kind": {"const": "kernel_slice"},
        "schema": {"const": "stwo.gpu-lab.slab-semantics.v1"},
        "scope": {"const": "cairo.witness.pedersen_builtin.base-trace-and-facts"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_closure": {
      "type": "object", "additionalProperties": false,
      "required": ["closure_sha256", "sources"],
      "properties": {
        "closure_sha256": {"$ref": "#/$defs/sha256"},
        "sources": {
          "type": "array", "minItems": 22, "maxItems": 22,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "content_path": {"type": "string", "pattern": "^chunks/sha256/[0-9a-f]{64}\\.m31le$"},
    "table": {
      "type": "object", "additionalProperties": false,
      "required": ["encoding", "path", "sha256", "element_count", "byte_len"],
      "properties": {
        "encoding": {"const": "m31-le-u32-row-major-v1"},
        "path": {"$ref": "#/$defs/content_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "element_count": {"type": "integer", "minimum": 4, "maximum": 268435456},
        "byte_len": {"type": "integer", "minimum": 16}
      }
    },
    "chunk_base": {
      "type": "object", "additionalProperties": false,
      "required": ["encoding", "path", "sha256", "row_start", "row_count", "words_per_row", "byte_len"],
      "properties": {
        "encoding": {"const": "m31-le-u32-row-major-v1"},
        "path": {"$ref": "#/$defs/content_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "row_start": {"type": "integer", "minimum": 0},
        "row_count": {"type": "integer", "minimum": 1, "maximum": 65536},
        "words_per_row": {"type": "integer"},
        "byte_len": {"type": "integer", "minimum": 1}
      }
    },
    "chunk3": {"allOf": [{"$ref": "#/$defs/chunk_base"}, {"properties": {"words_per_row": {"const": 3}}}]},
    "chunk23": {"allOf": [{"$ref": "#/$defs/chunk_base"}, {"properties": {"words_per_row": {"const": 23}}}]}
  }
}
