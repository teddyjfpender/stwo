{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stwo.dev/gpu-lab/host-oracle-index-v1.schema.json",
  "title": "Stwo GPU lab sealed host-oracle wrapper",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_sha256", "oracle_artifact", "exporter"],
  "properties": {
    "schema_version": {"const": "stwo.gpu-lab.host-oracle-index.v1"},
    "fixture_sha256": {"$ref": "#/$defs/sha256"},
    "oracle_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(evidence|scratchpad)/.+\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closure_sha256", "sources", "executable_sha256"],
      "properties": {
        "closure_sha256": {"$ref": "#/$defs/sha256"},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "pattern": "^(stwo|stwo-cairo)/.+"},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
