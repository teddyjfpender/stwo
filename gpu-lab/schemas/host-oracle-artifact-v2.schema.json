{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stwo.dev/gpu-lab/host-oracle-artifact-v2.schema.json",
  "title": "Stwo GPU lab streamed independent host-oracle artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "fixture_index_sha256", "semantic_identity", "full_proof_semantic_hash", "semantic_operation", "oracle", "production_crosscheck", "validation", "expected"],
  "properties": {
    "schema_version": {"const": "stwo.gpu-lab.host-oracle-index.v2"},
    "fixture_id": {"type": "string", "minLength": 1},
    "fixture_index_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_identity": {"$ref": "#/$defs/semantic_identity"},
    "full_proof_semantic_hash": {"type": "null"},
    "semantic_operation": {"const": "cairo.witness.pedersen_builtin"},
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "golden_evaluator_path", "candidate_gpu_executed", "candidate_recording_used"],
      "properties": {
        "engine": {"const": "candidate-free scalar slab semantics"},
        "golden_evaluator_path": {"const": "stwo-cairo/gpu_benchmarks/lab/fixture-export/src/pedersen_builtin_semantics.rs"},
        "candidate_gpu_executed": {"const": false},
        "candidate_recording_used": {"const": false}
      }
    },
    "production_crosscheck": {"$ref": "#/$defs/source_closure"},
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["scalar_golden_rows", "production_simd_crosschecked_rows", "words_compared_to_checked_fixture", "checked_fixture_match", "peak_chunk_rows", "peak_chunk_payload_bytes", "resident_table_words", "max_simd_rows_per_segment", "estimated_exporter_peak_bytes", "max_exporter_estimated_peak_bytes"],
      "properties": {
        "scalar_golden_rows": {"type": "integer", "minimum": 1},
        "production_simd_crosschecked_rows": {"type": "integer", "minimum": 1},
        "words_compared_to_checked_fixture": {"type": "integer", "minimum": 23},
        "checked_fixture_match": {"const": true},
        "peak_chunk_rows": {"type": "integer", "minimum": 1},
        "peak_chunk_payload_bytes": {"type": "integer", "minimum": 1},
        "resident_table_words": {"type": "integer", "minimum": 3},
        "max_simd_rows_per_segment": {"const": 1048576},
        "estimated_exporter_peak_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "max_exporter_estimated_peak_bytes": {"const": 1073741824}
      }
    },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["encoding", "words_per_row", "row_count", "logical_sha256", "chunks"],
      "properties": {
        "encoding": {"const": "m31-le-u32-row-major-v1"},
        "words_per_row": {"const": 23},
        "row_count": {"type": "integer", "minimum": 1},
        "logical_sha256": {"$ref": "#/$defs/sha256"},
        "chunks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chunk"}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema", "scope", "sha256"],
      "properties": {
        "kind": {"const": "kernel_slice"},
        "schema": {"const": "stwo.gpu-lab.slab-semantics.v1"},
        "scope": {"const": "cairo.witness.pedersen_builtin.base-trace-and-facts"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_closure": {
      "type": "object", "additionalProperties": false,
      "required": ["closure_sha256", "sources"],
      "properties": {
        "closure_sha256": {"$ref": "#/$defs/sha256"},
        "sources": {
          "type": "array", "minItems": 22, "maxItems": 22,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "chunk": {
      "type": "object", "additionalProperties": false,
      "required": ["encoding", "path", "sha256", "row_start", "row_count", "words_per_row", "byte_len"],
      "properties": {
        "encoding": {"const": "m31-le-u32-row-major-v1"},
        "path": {"type": "string", "pattern": "^chunks/sha256/[0-9a-f]{64}\\.m31le$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "row_start": {"type": "integer", "minimum": 0},
        "row_count": {"type": "integer", "minimum": 1},
        "words_per_row": {"const": 23},
        "byte_len": {"type": "integer", "minimum": 92}
      }
    }
  }
}
